# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules/

# Don't include the compiled root main.js file in the repo.
/main.js

# Source branch keeps generated publish trees local-only.
/plugin/
/official/
/channel/
/.workflow/publish/

# Keep the single bridge-version legacy plugin release tree trackable on source branch.
/release/*
!/release/latest.json
!/release/friday-obsidian-plugin/
!/release/friday-obsidian-plugin/main.js
!/release/friday-obsidian-plugin/manifest.json
!/release/friday-obsidian-plugin/styles.css
!/release/friday-obsidian-plugin/CHANGELOG.md
/release/*.zip

# Exclude sourcemaps
*.map

# obsidian
data.json
data.json.bak-*

# Exclude macOS Finder (System Explorer) View States
.DS_Store

		"jiti": "2.6.1",
		"obsidian": "^1.8.0",
		"simple-git": "^3.28.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"diff": "^8.0.4",
